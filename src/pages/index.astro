---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}affair-logo.png`} />
		<meta name="viewport" content="width=device-width" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Love+Light&family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet">
    <title>AFFAIR Memecoin</title>
    <style>
      body {
        margin: 0;
        font-family: "Love Light", cursive;
  		font-weight: 400;
  		font-style: normal;
        background: #f9f9f9;
        color: #222;
      }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 2rem;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .logo img {
        height: 40px;
        width: 40px;
        border-radius: 50%;
        border: 2px solid #e0e0e0;
      }
      .nav {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      .nav a {
        text-decoration: none;
        color: #222;
        font-weight: 500;
        transition: color 0.2s;
        padding: 0.25rem 0.5rem;
      }
      .nav a:hover {
        color: #ff4c8b;
      }
      .buy-btn {
        background: #ff4c8b;
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s;
      }
      .buy-btn:hover {
        background: #e03e74;
      }
      section {
        padding: 4rem 1rem 3rem 1rem;
        max-width: 800px;
        margin: 0 auto;
      }
      section h2 {
        color: #ff4c8b;
        margin-bottom: 1rem;
        font-size: 75px;
        font-family: "Love Light", cursive;
        font-weight: 800;
        letter-spacing: 1px;
      }
      section p, section ol, section ul, .how-to-buy-text {
        font-family: "Love Ya Like A Sister", cursive;
  		font-weight: 400;
  		font-style: normal;
		font-size: 28px;
      }
      /* How to Buy Cards */
      .how-to-buy-cards {
        display: flex;
        gap: 2rem;
        justify-content: center;
        margin-top: 2rem;
        flex-wrap: wrap;
      }
      .how-to-buy-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 4px 24px 0 rgba(0,0,0,0.08);
        display: flex;
        align-items: flex-start;
        padding: 2rem 1.5rem;
        min-width: 260px;
        max-width: 340px;
        flex: 1 1 260px;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
        transition: box-shadow 0.2s, transform 0.2s;
      }
      .how-to-buy-card:hover {
        box-shadow: 0 8px 32px 0 rgba(255,76,139,0.12);
        transform: translateY(-4px) scale(1.03);
      }
      .how-to-buy-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px 0 rgba(0,0,0,0.04);
      }
      .how-to-buy-icon img {
        width: 36px;
        height: 36px;
        object-fit: contain;
      }
      .how-to-buy-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .how-to-buy-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-family: "Love Ya Like A Sister", cursive;
  		font-weight: 400;
  		font-style: normal;
        letter-spacing: 0.5px;
      }
      .how-to-buy-text {
        font-size: 1rem;
        color: #444;
        font-family: "Love Ya Like A Sister", cursive;
  		font-weight: 400;
  		font-style: normal;
      }
      /* Home section icons */
      .home-content-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 2rem;
        margin-top: 2.5rem;
      }
      .home-left {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
      }
      .home-icons-row {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        margin: 0;
      }
      .home-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #fff;
        transition: box-shadow 0.2s, transform 0.2s;
      }
      .home-icon img {
        width: 60px;
        height: 60px;
        object-fit: contain;
      }
      .home-coin-logo {
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        height: 100%;
      }
      .home-coin-logo img {
        width: 260px;
        height: 260px;
        object-fit: contain;
        border-radius: 32px;
      }
      /* Roadmap timeline */
      .roadmap-timeline {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        gap: 2rem;
        margin-top: 2.5rem;
        position: relative;
      }
      .roadmap-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 4px 24px 0 rgba(0,0,0,0.08);
        padding: 2rem 1.5rem;
        min-width: 220px;
        max-width: 300px;
        flex: 1 1 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .roadmap-timeline::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(90deg, #ff4c8b 0%, #ffb86b 100%);
        z-index: 0;
        transform: translateY(-50%);
      }
      .roadmap-card:not(:last-child)::after {
        content: '';
        position: absolute;
        right: -1rem;
        top: 50%;
        width: 2rem;
        height: 6px;
        background: transparent;
        z-index: 2;
      }
      @media (max-width: 900px) {
        .how-to-buy-cards {
          flex-direction: column;
          align-items: stretch;
          gap: 1.5rem;
        }
        .how-to-buy-card {
          max-width: 100%;
        }
        .roadmap-timeline {
          flex-direction: column;
          gap: 2.5rem;
          align-items: stretch;
        }
        .roadmap-timeline::before {
          left: 50%;
          top: 0;
          bottom: 0;
          width: 6px;
          height: 100%;
          background: linear-gradient(180deg, #ff4c8b 0%, #ffb86b 100%);
          transform: translateX(-50%);
        }
        .roadmap-card {
          max-width: 100%;
        }
        .roadmap-card:not(:last-child)::after {
          content: '';
          position: absolute;
          left: 50%;
          top: 100%;
          width: 6px;
          height: 2rem;
          background: transparent;
          z-index: 2;
          transform: translateX(-50%);
        }
        .home-content-row {
          flex-direction: column;
          align-items: stretch;
        }
        .home-coin-logo {
          justify-content: center;
          margin-top: 2rem;
        }
        .home-coin-logo img {
          width: 120px;
          height: 120px;
        }
      }
      @media (max-width: 600px) {
        .topbar {
          flex-direction: column;
          gap: 0.5rem;
          padding: 1rem;
        }
        .nav {
          gap: 1rem;
        }
      }
      .fade-in-section {
        opacity: 0;
        transform: translateY(60px);
        transition: opacity 0.8s cubic-bezier(0.4,0,0.2,1), transform 0.8s cubic-bezier(0.4,0,0.2,1);
        will-change: opacity, transform;
      }
      .fade-in-section.visible {
        opacity: 1;
        transform: none;
      }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const sections = document.querySelectorAll('.fade-in-section');
        const observer = new window.IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        sections.forEach(section => observer.observe(section));
      });
    </script>
	</head>
	<body>
