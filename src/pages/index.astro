      </div>
      <nav class="nav">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#how-to-buy">How to Buy</a>
        <a href="#tokenomics">Tokenomics</a>
        <a href="#roadmap">Roadmap</a>
        <button class="buy-btn" onclick="window.open('https://coinbook.fun/token/53vD5Dcu1RDX4PS5krMHEpjA9BSH1FmAyydiFz12coin', '_blank')">Buy Now</button>
