              <a class="home-icon" href="https://coinbook.fun/token/53vD5Dcu1RDX4PS5krMHEpjA9BSH1FmAyydiFz12coin" target="_blank" rel="noopener" title="Coinbook.fun">
                <img src={`${import.meta.env.BASE_URL}coinbook-logo.png`} alt="Coinbook.fun" />
